# ======================
# Required
# ======================
# Use the Supabase Postgres connection string here, not the HTTPS project URL.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAILS=owner@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ======================
# OAuth (optional)
# Configure providers in Supabase Auth. Google OAuth redirects to:
# http://localhost:3001/auth/callback
# https://your-domain.com/auth/callback
# ======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_AUTH_KEY_ID=

# ======================
# AI (optional — enables AI features)
# ======================
# Local Ollama: http://localhost:11434
# Ollama Cloud direct API: https://ollama.com
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# Google Gemini — nutrition label OCR & AI chat
GOOGLE_AI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# MiniMax — alternative AI provider for PR review
MINIMAX_API_KEY=

# ======================
# Payments (optional — enables Pro plan)
# ======================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ======================
# Web Push (optional — enables push notifications)
# Generate with: npx web-push generate-vapid-keys
# ======================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ======================
# Observability (optional)
# ======================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=

# ======================
# YouTube (optional — Huberman digest script)
# ======================
YOUTUBE_API_KEY=
